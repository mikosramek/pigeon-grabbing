{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "make && /Applications/ares.app/Contents/MacOS/ares ./pigeon_grabbing.z64 --args --terminal"
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make clean"
    },
    {
      "label": "build + unfload",
      "type": "shell",
      "command": "make && ../UNFLoader -r ./pigeon_grabbing.z64"
    },
    {
      "label": "build + unfload (listen)",
      "type": "shell",
      "command": "make && ../UNFLoader -r ./pigeon_grabbing.z64 -l"
    }
  ]
}
